# Server Configuration
PORT=5000
HOST=127.0.0.1
NODE_ENV=development

# Target Application (Juice Shop)
TARGET_URL=http://127.0.0.1:3000
TARGET_NAME=OWASP Juice Shop
TARGET_VERSION=v16.0.0 (Official Docker Image)

# Evidence Storage
UPLOAD_DIR=./uploads/evidence
MAX_FILE_SIZE_MB=15

# Security Scope
AUTHORIZED_TESTING_ONLY=true
